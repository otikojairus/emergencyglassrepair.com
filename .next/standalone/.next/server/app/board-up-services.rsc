17:T96e,[{"@context":"https://schema.org","@type":"Service","name":"Board up services in Canada","serviceType":"board up services","provider":{"@type":"Organization","name":"Emergency Glass Repair Canada","telephone":"+18884960133","url":"https://emergencyglassconnect.com/"},"areaServed":"Canada (National)","url":"https://emergencyglassconnect.com/board-up-services","description":"Board-up is about liability: sharp glass, weather, and theft risk until permanent glazing returns. This page is for anyone searching board up services across Canada—retail, restaurants, offices, and property managers with a broken opening. Ceiling height, door hardware, and whether the lite is tempered or laminated help us quote accurately. Search demand for board up services stays high year-round—volume in the hundreds of monthly lookups reflects how often storefronts fail without warning. Dial 1-888-496-0133 for a clear timeline on security, measurement, and install."},{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://emergencyglassconnect.com/"},{"@type":"ListItem","position":2,"name":"Services","item":"https://emergencyglassconnect.com/services"},{"@type":"ListItem","position":3,"name":"Board up services Canada","item":"https://emergencyglassconnect.com/board-up-services"}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is board up services in Canada priced per pane or per opening?","acceptedAnswer":{"@type":"Answer","text":"We do not publish one national price because door hardware and tempered thickness vary. 1-888-496-0133 outlines typical costs for Canada."}},{"@type":"Question","name":"How soon can you do board up services in Canada?","acceptedAnswer":{"@type":"Answer","text":"Board-up can often happen the same night; custom glass depends on supplier lead times. Share urgency when you dial 1-888-496-0133."}},{"@type":"Question","name":"Can you work with my property manager for board up services in Canada?","acceptedAnswer":{"@type":"Answer","text":"Clear a path to the opening and note ceiling height limits for long glass panels."}},{"@type":"Question","name":"Can I book board up services for a franchise location in Canada?","acceptedAnswer":{"@type":"Answer","text":"Yes—1-888-496-0133 is the same nationwide. This page adds local context for Canada."}}]}]c:["$","main",null,{"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$17"}}],["$","nav",null,{"className":"breadcrumb wrap","aria-label":"Breadcrumb","children":[["$","$L1a",null,{"href":"/","children":"Home"}],["$","span",null,{"aria-hidden":"true","children":" / "}],["$","$L1a",null,{"href":"/services","children":"Services"}],["$","span",null,{"aria-hidden":"true","children":" / "}],["$","span",null,{"aria-current":"page","children":"Board up services Canada"}]]}],["$","section",null,{"className":"shard-hero shard-hero--page","children":[["$","div",null,{"className":"shard-hero-copy","children":[["$","p",null,{"className":"shard-kicker","children":"Canada"}],["$","h1",null,{"children":"Board up services in Canada"}],["$","div",null,{"className":"shard-lead","children":["$","p",null,{"children":"National board up services: security first, then field measurements for code-compliant replacement glass."}]}],["$","div",null,{"className":"shard-actions","children":[["$","a",null,{"className":"btn btn-amber","href":"tel:+18884960133","children":[["$","span",null,{"className":"btn-label","children":"Call now"}],["$","span",null,{"className":"btn-value","children":"1-888-496-0133"}]]}],"$L1b"]}]]}],"$L1c"]}],"$L1d"]}]
